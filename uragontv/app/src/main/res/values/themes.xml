<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.UragonTv" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/uragon_blue</item>
        <item name="colorPrimaryDark">@color/uragon_blue_dark</item>
        <item name="colorAccent">@color/uragon_accent</item>
        <item name="android:windowBackground">@color/uragon_navy</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/uragon_navy_dark</item>
        <item name="android:navigationBarColor" tools:targetApi="l">@color/uragon_navy_dark</item>
    </style>

    <style name="Theme.UragonTv.Splash" parent="Theme.UragonTv">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="UragonCard" parent="CardView">
        <item name="cardBackgroundColor">@color/card_background</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">4dp</item>
    </style>
</resources>
